# Copy to .env. Only secrets and endpoints live here; tuning lives in config/*.yaml.
# Native runs (make dev-api, make dev-agent, make benchmark) read this file directly.
# Under `make up`, compose reads it for the api and agent containers, but replaces the
# addresses marked (compose sets this) with ones that resolve inside the containers.
# A commented line shows the default; uncomment it to change it.

# --- API and agent worker (backend/infrastructure/config/settings.py) -------------------

PIPELINE=api                    # default for calls that don't pick one: api | selfhosted
PERSONA=law_firm
ENDPOINTER=semantic             # semantic | silence

# LiveKit: the compose file runs a local dev server (devkey/secret). For LiveKit Cloud,
# set all three from the project settings page.
LIVEKIT_URL=ws://localhost:7880                # (compose sets this) where the agent connects
# LIVEKIT_PUBLIC_URL=           # what the browser dials, when different (compose: localhost)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# API pipeline
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Self-hosted pipeline (the GPU box; see gpu/README.md). Under `make up` compose builds
# these three from GPU_HOST instead (default host.docker.internal: this machine).
VLLM_BASE_URL=http://localhost:8000/v1         # (compose sets this)
WHISPER_WS_URL=ws://localhost:8001/v1/stream   # (compose sets this)
KOKORO_URL=http://localhost:8002               # (compose sets this)
# VLLM_MODEL=voice-llm          # the served-model-name; the Ollama tag with LLM_SERVER=ollama
# LLM_SERVER=vllm               # vllm | ollama (laptop demo)
# SELFHOSTED_ON_LOCAL_MACHINE=false  # true when the self-hosted models run on this laptop
# SELFHOSTED_MAX_CONCURRENCY=40

# A file name in config/serving/. Read by the harness (provenance) and, with the same
# meaning, by gpu/docker-compose.gpu.yml and gpu/runpod/start.sh to start vLLM.
# SERVING_CONFIG=qwen-9b-l40s.yaml

DATABASE_URL=postgresql://vcb:vcb@localhost:5432/vcb   # (compose sets this); empty: in-memory
# API_BASE_URL=http://localhost:8080   # (compose sets this) where the agent sends live metrics
INTERNAL_TOKEN=change-me                # shared by the API and the agent worker
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEV_SPEND_LIMIT_USD=25
# SIMULATE_PROVIDERS=false      # true: both pipelines run on a simulated GPU, no keys needed
# CONFIG_DIR=                   # defaults to this repo's config/

# --- make up only (docker-compose.yml) -----------------------------------------------------

# GPU_HOST=host.docker.internal # where the api and agent containers reach vLLM/Whisper/Kokoro
# LIVEKIT_AGENT_URL=ws://livekit:7880      # where the agent container reaches LiveKit

# --- GPU node (gpu/docker-compose.gpu.yml, gpu/runpod/start.sh) ----------------------------

# HF_TOKEN=                     # for gated model weights
# HF_HOME=/workspace/hf-cache   # RunPod: weights on the persistent volume
# WHISPER_BACKEND=faster-whisper  # faster-whisper | mlx (Apple Silicon)
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_MLX_REPO=mlx-community/whisper-large-v3-turbo
# WHISPER_WORKERS=3
# KOKORO_DEVICE=                # empty: Kokoro picks
# KOKORO_WORKERS=3
