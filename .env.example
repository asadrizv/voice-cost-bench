# Copy to .env. Only secrets and endpoints live here; tuning lives in config/*.yaml.

PIPELINE=api                    # default for calls that don't pick one: api | selfhosted
PERSONA=law_firm
ENDPOINTER=semantic             # semantic | silence

# LiveKit: the compose file runs a local dev server (devkey/secret). For LiveKit Cloud,
# set all three from the project settings page.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# API pipeline
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Self-hosted pipeline (the GPU box; see gpu/README.md)
VLLM_BASE_URL=http://localhost:8000/v1
WHISPER_WS_URL=ws://localhost:8001/v1/stream
KOKORO_URL=http://localhost:8002

DATABASE_URL=postgresql://vcb:vcb@localhost:5432/vcb
DEV_SPEND_LIMIT_USD=25
INTERNAL_TOKEN=change-me
