# Copy to .env. Only secrets and endpoints live here; tuning lives in config/*.yaml.
# Native runs read it as is. Under `make up`, compose replaces the lines marked (compose)
# with addresses that resolve inside the api and agent containers.

# --- API and agent worker (backend/infrastructure/config/settings.py) ---
PIPELINE=api                    # default for calls that don't pick one: api | selfhosted
PERSONA=law_firm
ENDPOINTER=semantic             # semantic | silence | smart_turn
EU_ONLY=false                   # true: refuse to start unless every component a call could
                                # touch is EU-resident, and serve only PIPELINE above

# LiveKit: the compose file runs a local dev server (devkey/secret). For LiveKit Cloud,
# set all three from the project settings page.
LIVEKIT_URL=ws://localhost:7880         # (compose) where the agent connects
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Self-hosted pipeline (the GPU node; see gpu/README.md). Compose builds these from GPU_HOST.
VLLM_BASE_URL=http://localhost:8000/v1          # (compose)
WHISPER_WS_URL=ws://localhost:8001/v1/stream    # (compose)
KOKORO_URL=http://localhost:8002                # (compose)
VLLM_MODEL=voice-llm            # vLLM's served-model-name, or the Ollama tag
LLM_SERVER=vllm                 # vllm | ollama (laptop demo)
SELFHOSTED_ON_LOCAL_MACHINE=false
SELFHOSTED_MAX_CONCURRENCY=40
SERVING_CONFIG=qwen-9b-l40s.yaml  # a file in config/serving/; vLLM starts from the same one

DATABASE_URL=postgresql://vcb:vcb@localhost:5432/vcb   # (compose) empty: in-memory
API_BASE_URL=http://localhost:8080      # (compose) where the agent sends live metrics
INTERNAL_TOKEN=change-me                # shared by the API and the agent worker
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEV_SPEND_LIMIT_USD=25
SIMULATE_PROVIDERS=false        # true: a simulated GPU, no keys, every cost fiction
# CONFIG_DIR=                   # defaults to this repo's config/

# --- make up only (docker-compose.yml) ---
GPU_HOST=host.docker.internal   # the GPU node, as the api and agent containers reach it
LIVEKIT_AGENT_URL=ws://livekit:7880

# --- GPU node services: read from their own environment (shell, pod template), not here ---
HF_TOKEN=
# HF_HOME=                     # gpu/runpod/start.sh puts it on the /workspace volume
WHISPER_BACKEND=faster-whisper  # faster-whisper | mlx | voxtral (Apple Silicon) | voxtral-vllm
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_MLX_REPO=mlx-community/whisper-large-v3-turbo
VOXTRAL_MLX_REPO=mlx-community/Voxtral-Mini-4B-Realtime-2602-4bit
VOXTRAL_VLLM_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602
# VOXTRAL_VLLM_URL=            # unset: compose names the container, a pod uses localhost
# VOXTRAL_VLLM_FLUSH_TIMEOUT_S=3.0  # how long a flush waits for transcription.done
# VOXTRAL_GPU_FRACTION=0.34    # its vLLM server's share of the card (gpu/README.md)
WHISPER_WORKERS=3
KOKORO_DEVICE=
KOKORO_WORKERS=3
# Kokoro alone speaks no German: the law_firm_de persona asks for qwen3-tts:clara_de, and
# without a Qwen3-TTS runtime here a German self-hosted call is refused before it starts.
TTS_ENGINES=kokoro               # kokoro[,qwen3-tts (Apple Silicon) | ,qwen3-tts-vllm]
QWEN3_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-8bit
QWEN3_TTS_VLLM_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN3_TTS_VLLM_URL=          # unset for the same reason
# QWEN3_TTS_GPU_FRACTION=0.30  # its vLLM-Omni server's share of the card
# QWEN3_TTS_VOICES=              # defaults to gpu/kokoro_service/voices.yaml
