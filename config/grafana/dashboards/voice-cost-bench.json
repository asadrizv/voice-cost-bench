{
  "uid": "voice-cost-bench",
  "title": "Voice Cost Bench",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "voice"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active calls",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(voice_active_calls)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost per minute (latest call)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pipeline) (voice_call_cost_per_minute_usd)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API spend (Postgres)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "voice_spend_usd{pipeline=\"api\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "vLLM waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vllm:num_requests_waiting)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "End-to-end p95 (budget 900 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"end_to_end\"}[1m])))",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Perceived delay p95 (budget 1200 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"perceived_delay\"}[1m])))",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Stage p50",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"endpoint_detected\"}[1m])))",
          "legendFormat": "endpoint_detected {{pipeline}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"stt_final\"}[1m])))",
          "legendFormat": "stt_final {{pipeline}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"llm_first_token\"}[1m])))",
          "legendFormat": "llm_first_token {{pipeline}}"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.5, sum by (le, pipeline) (rate(voice_turn_latency_ms_bucket{stage=\"tts_first_byte\"}[1m])))",
          "legendFormat": "tts_first_byte {{pipeline}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost accrual rate by component",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pipeline, component) (rate(voice_cost_usd_total[1m])) * 60",
          "legendFormat": "{{pipeline}} {{component}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "vLLM running / waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "vLLM KV cache usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vllm:kv_cache_usage_perc or vllm:gpu_cache_usage_perc)",
          "legendFormat": "kv cache"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "vLLM TTFT p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "ttft p95"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "vLLM preemptions / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vllm:num_preemptions_total[1m]))",
          "legendFormat": "preemptions"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Whisper / Kokoro queues",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(whisper_waiting)",
          "legendFormat": "whisper waiting"
        },
        {
          "refId": "B",
          "expr": "max(kokoro_waiting)",
          "legendFormat": "kokoro waiting"
        },
        {
          "refId": "C",
          "expr": "max(whisper_in_flight)",
          "legendFormat": "whisper in flight"
        },
        {
          "refId": "D",
          "expr": "max(kokoro_in_flight)",
          "legendFormat": "kokoro in flight"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU (DCGM)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "util %"
        },
        {
          "refId": "B",
          "expr": "max(DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "power W"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GPU memory used (DCGM)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(DCGM_FI_DEV_FB_USED)",
          "legendFormat": "MiB used"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Turns / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pipeline) (rate(voice_turns_total[1m])) * 60",
          "legendFormat": "{{pipeline}}"
        }
      ]
    }
  ]
}